{
	"name": "Al-Rawi",
	"image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
	"features": {
		"ghcr.io/devcontainers/features/node:1": {
			"version": "22"
		},
		"ghcr.io/devcontainers/features/docker-in-docker:2": {},
		"ghcr.io/devcontainers/features/github-cli:1": {},
		"ghcr.io/va-h/devcontainers-features/uv:1": {}
	},
	"containerEnv": {
		"COREPACK_ENABLE_DOWNLOAD_PROMPT": "0",
		"UV_LINK_MODE": "copy"
	},
	"forwardPorts": [3000, 8000, 5432, 6379],
	"portsAttributes": {
		"3000": { "label": "Next.js (web)", "onAutoForward": "openBrowser" },
		"8000": { "label": "FastAPI (api)" },
		"5432": { "label": "Postgres + pgvector", "onAutoForward": "silent" },
		"6379": { "label": "Redis", "onAutoForward": "silent" }
	},
	"postCreateCommand": "corepack enable && pnpm install && pnpm bootstrap",
	"postStartCommand": "pnpm services:up",
	"customizations": {
		"vscode": {
			"extensions": [
				"biomejs.biome",
				"charliermarsh.ruff",
				"ms-python.python",
				"bradlc.vscode-tailwindcss",
				"editorconfig.editorconfig",
				"ms-azuretools.vscode-docker",
				"github.vscode-github-actions",
				"redhat.vscode-yaml"
			]
		}
	}
}
