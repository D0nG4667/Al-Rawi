{
	"name": "al-rawi",
	"version": "1.0.0",
	"private": true,
	"description": "Al-Rawi monorepo tooling: git hooks, commit conventions and cross-stack developer scripts",
	"packageManager": "pnpm@10.23.0",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"prepare": "lefthook install",
		"hooks:install": "lefthook install --reset-hooks-path",
		"hooks:validate": "lefthook validate"
	},
	"devDependencies": {
		"@commitlint/cli": "^19.0.0",
		"@commitlint/config-conventional": "^19.0.0",
		"lefthook": "^2.2.2"
	},
	"pnpm": {
		"onlyBuiltDependencies": ["lefthook"]
	}
}
