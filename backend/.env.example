# App Configurations
APP_NAME="Al-Rawi API"
APP_VERSION="0.1.0"
API_V1_STR="/api/v1"

# Required Settings
GOOGLE_API_KEY=your_gemini_api_key_here
# Local docker stack (pnpm services:up from the repo root):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/neondb
# Neon serverless (staging / production):
# DATABASE_URL=postgresql://user:password@ep-cool-db.region.aws.neon.tech/neondb?sslmode=require
REDIS_URL=redis://localhost:6379

# Observability
SENTRY_DSN=your_sentry_dsn_here

# Integrations (Optional fallbacks)
ELEVEN_API_KEY=your_eleven_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
