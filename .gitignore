docs/superpowers/plans/

# ------------------------------------------
# Data Ingestion Caches (Do not commit large binaries/dbs)
# ------------------------------------------
backend/data/raw/
backend/data/processed/


# ------------------------------------------
# Environment Variables
# ------------------------------------------
.env
.env.local
.env.*.local
*.env

# ------------------------------------------
# Next.js / Frontend (Node)
# ------------------------------------------
node_modules/
.pnp
.pnp.js
.next/
out/
build/
dist/
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.vercel

# ------------------------------------------
# Turborepo
# ------------------------------------------
.turbo/

# ------------------------------------------
# FastAPI / Backend (Python)
# ------------------------------------------
.venv/
venv/
ENV/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Pytest / Coverage
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
pytestdebug.log

# Ruff / Linters
.ruff_cache/
.mypy_cache/

# IDE / OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Frontend overrides to prevent global lib/ ignore matching src/lib/
!frontend/src/lib/

