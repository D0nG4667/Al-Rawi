{
	"name": "al-rawi-frontend",
	"version": "1.0.0",
	"private": true,
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=24.0.0",
			"onFail": "download"
		},
		"packageManager": {
			"name": "pnpm",
			"version": ">=10.23.0",
			"onFail": "download"
		}
	},
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "biome lint .",
		"format": "biome format . --write",
		"format:check": "biome format .",
		"check": "biome ci .",
		"typecheck": "tsc --noEmit",
		"test": "node src/tests/admin-check.js && node src/tests/form-check.js && node src/tests/i18n-check.js && node src/tests/landing-check.js && node src/tests/og-check.js && node src/tests/patterns-check.js && node src/tests/pwa-check.js && node src/tests/ratelimit-check.js && node src/tests/readme-check.js && node src/tests/ui-moat-check.js"
	},
	"dependencies": {
		"@ducanh2912/next-pwa": "^10.2.9",
		"@neondatabase/auth": "0.4.2-beta",
		"@react-three/drei": "^10.7.7",
		"@react-three/fiber": "^9.6.1",
		"@react-three/postprocessing": "^3.0.4",
		"@sentry/nextjs": "^10.62.0",
		"@studio-freight/lenis": "^1.0.42",
		"@upstash/ratelimit": "^2.0.8",
		"@upstash/redis": "^1.38.0",
		"@xyflow/react": "^12.11.2",
		"framer-motion": "^12.42.0",
		"gsap": "^3.15.0",
		"lucide-react": "^1.22.0",
		"next": "16.2.9",
		"next-intl": "^4.13.0",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"three": "^0.185.0",
		"zustand": "^5.0.14"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.1",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^26",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@types/three": "^0.185.1",
		"babel-plugin-react-compiler": "1.0.0",
		"eslint": "^9",
		"eslint-config-next": "16.2.9",
		"tailwindcss": "^4",
		"typescript": "^5"
	}
}
